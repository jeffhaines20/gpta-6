node_modules/
# package-lock.json is deliberately NOT ignored. It was, until 2026-08-30, from
# back when this repo declared no dependencies at all. Once CI existed that made
# actions/setup-node's npm cache fail instantly with nothing to hash, and would
# have broken `npm ci` right after. The lockfile is what makes a CI install
# reproducible, so it is tracked. The GAME still ships zero runtime dependencies -
# playwright is a test-harness devDependency and never reaches the browser.
docs/drive*.json.bak

# Builder scratch: diagnostic scripts and probe captures that agents write while
# iterating. Underscore-prefixed by convention so they are easy to exclude.
.signage-shots.mjs
# Dot-prefixed probes follow the same convention as the underscore ones above:
# throwaway diagnostic scripts agents write while iterating (.audit.mjs,
# .geom-probe.mjs, .tex-dump.mjs, .top-down.mjs and friends).
.*.mjs
labs/**/_*
docs/shots/_*.png

# Reprojected pano views: derived from CC BY-SA source imagery, regenerable
# from tools/reproject-pano.mjs plus the index. Tracking them would double the
# reference weight for nothing.
reference/sarasota/mapillary/views/

# Matched-camera frames: regenerable from tools/pano-match.mjs plus the reference
# index. The measurements of record are the JSON beside them; the handful of frames
# a finding was actually read from are force-added.
docs/shots/pano-match/*.png

# Glazing probe captures: many variants per run, regenerable from tools/glaz-probe.mjs.
# The two corridor golden frames the finding was read from are force-added.
docs/shots/glaz-*.png

# Superseded lamp-onscreen probe captures. Its question is answered better by the
# lamp-ab pair (committed) and tools/lamp-hysteresis.mjs, and each frame is ~1.3 MB.
docs/shots/lamp-night-before.png
docs/shots/lamp-night-after.png
docs/shots/lamp-dusk-before.png
docs/shots/lamp-dusk-after.png

# Oak development captures: many per run, regenerable from tools/oak-shots.mjs.
# The three the finding was read from are force-added.
docs/shots/oak2-*.png
docs/shots/oak-*.png

# The oak bench writes a scratch page next to its frames so Chromium can load
# it from the served tree. It is a build artifact of tools/oak-look.mjs, not a
# frame worth keeping.
docs/shots/.oak-look.html
# Foliage-round bench frames, same reasoning as the oak-* lines above: sixteen
# of them is 12 MB, and what the round actually needs preserved is the NUMBERS
# they score, which live in the ledger and in docs/foliage-grain.json. Frames
# that cannot be regenerated once the geometry moves are exactly the case the
# instrument was built to replace.
docs/shots/tree3-*.png
