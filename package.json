{
  "name": "gpta-6",
  "private": true,
  "type": "module",
  "description": "Feasibility probe: procedural open-world driving/on-foot vertical slice in Three.js",
  "scripts": {
    "serve": "npx http-server -p 8123 -s .",
    "test:physics": "node tools/physics-test.mjs",
    "probe": "node tools/probe.mjs",
    "bake": "node tools/bake/fetch-osm.mjs && node tools/bake/bake.mjs",
    "bake:local": "node tools/bake/bake.mjs",
    "test:golden": "node tools/golden-trace.mjs",
    "drive": "node tools/drive-through.mjs",
    "drive:traffic": "node tools/drive-through.mjs --traffic",
    "sweep": "node tools/daynight-sweep.mjs",
    "chase": "node tools/chase-harness.mjs",
    "progress": "node tools/progress-page.mjs",
    "test:syntax": "node tools/check-syntax.mjs",
    "test:geometry": "node tools/geom-audit.mjs",
    "gates": "npm run gates:static && npm run gates:lighting && npm run gates:budget",
    "hero": "node tools/hero-shots.mjs",
    "test:lighting": "node tools/daynight-sweep.mjs",
    "gates:static": "node tools/check-syntax.mjs && node tools/golden-trace.mjs && node tools/physics-test.mjs && node tools/geom-audit.mjs",
    "gates:budget": "node tools/drive-through.mjs --traffic",
    "gates:lighting": "node tools/daynight-sweep.mjs",
    "test": "npm run gates",
    "test:geom": "node tools/geom-audit.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
